# MCP Server API Keys
# Copy this file to .env and fill in your actual keys

# ============================================
# TIER 1 - REQUIRED FOR CORE FUNCTIONALITY
# ============================================

# Firecrawl - Web scraping & crawling
# Get your free API key at: https://firecrawl.dev
# Free tier: 500 credits/month
FIRECRAWL_API_KEY=fc-your-key-here

# GitHub - Git automation, PR creation, code review
# Generate token at: https://github.com/settings/tokens
# Required scopes: repo, workflow, read:org
GITHUB_TOKEN=ghp_your-token-here

# Brave Search - Real-time web search
# Get your free API key at: https://brave.com/search/api
# Free tier: 2,000 queries/month
BRAVE_API_KEY=your-brave-key-here

# ============================================
# TIER 2 - OPTIONAL (ADD AS NEEDED)
# ============================================

# Sentry - Error tracking & monitoring
# Get DSN at: https://sentry.io
# Free tier: 5,000 events/month
# SENTRY_DSN=your-sentry-dsn-here

# Zapier - Connect to 8,000+ apps
# Get API key at: https://zapier.com/app/developer
# ZAPIER_API_KEY=your-zapier-key-here

# ============================================
# TIER 3 - SPECIALIZED (PROJECT-SPECIFIC)
# ============================================

# Slack - Team communication
# SLACK_TOKEN=xoxb-your-slack-token-here

# Linear - Project management
# LINEAR_API_KEY=lin_api_your-key-here

# Notion - Documentation & knowledge base
# NOTION_API_KEY=secret_your-notion-key-here

# AWS - Cloud infrastructure
# AWS_ACCESS_KEY_ID=your-access-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-key-here
# AWS_REGION=us-east-1

# ============================================
# NOTES
# ============================================
# 
# 1. NEVER commit .env to git (it's in .gitignore)
# 2. Each team member needs their own API keys
# 3. Free tiers are generous - start there
# 4. See MCP-ANALYSIS.md for detailed info on each service
# 5. See MCP-GUIDE.md for setup instructions


