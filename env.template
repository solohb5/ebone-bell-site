# MCP Server API Keys
# Copy this file to .env and fill in your API keys

# ============================================================
# CRITICAL - REQUIRED FOR CORE FUNCTIONALITY
# ============================================================

# Firecrawl - Web scraping & content extraction
# Get free tier (500 credits/mo) at: https://firecrawl.dev
# Sign up → Dashboard → API Keys → Copy key (starts with fc-)
FIRECRAWL_API_KEY=fc-your-key-here

# GitHub - PR creation, code review, repo management
# Generate at: https://github.com/settings/tokens
# Select scopes: repo, workflow, read:org
# Copy token (starts with ghp_)
GITHUB_TOKEN=ghp_your-token-here

# Brave Search - Real-time web search
# Get free tier (2,000 queries/mo) at: https://brave.com/search/api
# Sign up for free tier → Copy API key
BRAVE_API_KEY=your-brave-key-here

# ============================================================
# OPTIONAL - FOR ADVANCED FEATURES
# ============================================================

# Sentry - Error tracking & monitoring (optional)
# Get free tier (5,000 events/mo) at: https://sentry.io
# Create project → Settings → Client Keys → Copy DSN
# SENTRY_DSN=your-sentry-dsn-here

# ============================================================
# NOTES
# ============================================================
# 
# - Keep this file in .gitignore (DO NOT commit to git)
# - Use separate keys per project for security
# - Rotate keys periodically
# - Context7 & Sequential-Thinking require no API keys
# - All free tiers are generous for most projects
